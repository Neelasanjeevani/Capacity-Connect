# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# The exact origin your frontend is served from (no trailing slash).
# The API only accepts requests (and sets cookies) for this origin.
FRONTEND_ORIGIN=http://localhost:5500

# A long, random, secret string used to sign session tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# --- Email (SMTP) ---
# For Gmail: turn on 2-Step Verification on the sending account, then create
# an "App password" (Google Account -> Security -> App passwords) and use
# that here — never your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.address@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM="Capacity Connect <your.address@gmail.com>"

# The email of the first administrator account, created automatically the
# first time the server starts if no admin exists yet. You'll be emailed
# a one-time setup password — change it immediately after logging in.
INITIAL_ADMIN_EMAIL=admin@yourorganisation.org
